{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.pageFolders": [
    {
      "title": "Articles",
      "path": "[[workspace]]/content/posts",
      "previewPath": "",
      "trailingSlash": true,
      "contentTypes": ["article"]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "article",
      "pageBundle": true,
      "defaultFileName": "index",
      "fileType": "md",
      "previewPath": "",
      "trailingSlash": true,
      "template": "[[workspace]]/.frontmatter/templates/article.md",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true,
          "required": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft",
          "default": true
        },
        {
          "title": "Targets",
          "name": "targets",
          "type": "list"
        },
        {
          "title": "Key points",
          "name": "key_points",
          "type": "list"
        }
      ]
    }
  ],
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.filters": ["contentFolders"],
  "frontMatter.content.defaultSorting": "PublishedDesc",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.preview.trailingSlash": true,
  "frontMatter.website.host": "https://hrkz777.github.io",
  "frontMatter.snippets.wrapper.enabled": false,
  "frontMatter.content.snippets": {
    "Figure": {
      "description": "Insert an image from the current page bundle with a caption.",
      "body": "{{< article-figure src=\"[[&mediaUrl]]\" alt=\"[[alt]]\" caption=\"[[caption]]\" >}}",
      "isMediaSnippet": true
    },
    "Note": {
      "description": "Insert a note block.",
      "body": [
        "{{< note title=\"[[title]]\" >}}",
        "[[body]]",
        "{{< /note >}}"
      ],
      "fields": [
        {
          "name": "title",
          "title": "Title",
          "type": "string",
          "default": "注意"
        },
        {
          "name": "body",
          "title": "Body",
          "type": "string"
        }
      ]
    }
  }
}
